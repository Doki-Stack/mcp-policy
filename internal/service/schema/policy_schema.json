{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://doki-stack.dev/schemas/policy_schema.json",
  "title": "Policy",
  "description": "A semantic policy document ingested into the Policy MCP's Qdrant `policies` collection.",
  "type": "object",
  "required": ["org_id", "policy_id", "title", "text"],
  "additionalProperties": false,
  "properties": {
    "org_id": {
      "type": "string",
      "format": "uuid"
    },
    "policy_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "compliance_framework": {
      "type": "string",
      "maxLength": 100
    },
    "effective_date": {
      "type": "string",
      "format": "date-time"
    }
  }
}
